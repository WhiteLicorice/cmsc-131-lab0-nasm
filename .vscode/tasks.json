{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build & Run",
      "type": "shell",
      "command": "make",
      "args": ["PROG=${fileBasenameNoExtension}", "run"],
      "options": { "cwd": "${fileDirname}" },
      "windows": {
        "command": "mingw32-make",
        "options": {
          "cwd": "${fileDirname}",
          // Git Bash by full path, not the name. On a machine with WSL the
          // name bash.exe resolves to C:\Windows\System32\bash.exe, which
          // starts Linux and has no mingw32-make in it. The shell block
          // cannot be dropped either: the Makefile's recipes use rm, diff,
          // and ./prog, none of which cmd.exe can run.
          "shell": {
            "executable": "C:\\Program Files\\Git\\bin\\bash.exe",
            "args": ["-c"]
          }
        }
      },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Check",
      "type": "shell",
      "command": "make",
      "args": ["PROG=${fileBasenameNoExtension}", "check"],
      "options": { "cwd": "${fileDirname}" },
      "windows": {
        "command": "mingw32-make",
        "options": {
          "cwd": "${fileDirname}",
          // Git Bash by full path, not the name. On a machine with WSL the
          // name bash.exe resolves to C:\Windows\System32\bash.exe, which
          // starts Linux and has no mingw32-make in it. The shell block
          // cannot be dropped either: the Makefile's recipes use rm, diff,
          // and ./prog, none of which cmd.exe can run.
          "shell": {
            "executable": "C:\\Program Files\\Git\\bin\\bash.exe",
            "args": ["-c"]
          }
        }
      },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
